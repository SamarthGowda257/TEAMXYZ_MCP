# Environment variable example for TeamXYZ-MCP
# Copy this file to .env and fill in real values before starting the server.

# ─── Required ─────────────────────────────────────────────────────────────────

# Secret Bearer token that all MCP clients must send in the Authorization header.
# Generate a strong token, e.g.:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# The server will refuse to start if this is not set.
MCP_BEARER_TOKEN=replace-with-a-strong-secret-token

# ─── Optional ─────────────────────────────────────────────────────────────────

# Port the server listens on (default: 8000).
# On Render this is set automatically; you do not need to change it.
PORT=8000
