# WellNest Hospitals (TeamXYZ) - environment variables. Names only; values here are fake.
# Copy to .env for local runs. On Render, set these under the service's Environment tab.
# Never commit real values.

# --- Required: the token Talkdesk sends on /mcp (unchanged from V1) ---
MCP_BEARER_TOKEN=replace-with-a-strong-secret-token

# --- Database: Supabase Postgres, Transaction pooler URI (port 6543). Empty = local SQLite file (reset on every deploy).
DATABASE_URL=postgresql://postgres.your-project-ref:your-db-password@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres
AUTO_SEED=true

# --- Blackboard + event stream: Render Key Value (Internal URL) or Upstash. Empty = in-process memory and queue.
REDIS_URL=redis://red-xxxxxxxxxxxxxxxxxxxx:6379

# --- Website ---
PUBLIC_BASE_URL=https://teamxyz-mcp.onrender.com
SECRET_KEY=any-long-random-string-for-website-logins
DEMO_PASSWORD=WellNest@2026

# --- Ops (default to MCP_BEARER_TOKEN when empty) ---
DASHBOARD_TOKEN=
JOBS_TOKEN=

# --- Email (empty = emails are marked "simulated") ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=WellNest Hospitals <wellnest.demo@example.com>
DEMO_EMAIL_OVERRIDE=
# JSON map of persona -> real inbox for demos, e.g. {"shanthamma":"you@example.com","arjun":"teammate@example.com"}
DEMO_PERSONA_EMAILS=

# --- Talkdesk chat widget (empty touchpoint = "chat coming soon" button) ---
TALKDESK_TOUCHPOINT_ID=
TALKDESK_REGION=td-us-1
# Phone number of the Talkdesk Studio voice flow (AI receptionist). Shown on the website as "Call to book".
TALKDESK_VOICE_NUMBER=

# --- Hybrid search (keyword + fuzzy + meaning). Keyword and fuzzy need nothing; meaning needs a Google AI Studio key ---
# Free key: https://aistudio.google.com/app/apikey . Without it search runs as keyword + fuzzy.
EMBEDDINGS_API_KEY=
EMBEDDINGS_MODEL=gemini-embedding-001
# Cosine a meaning-only match needs (tune with scripts/eval_search.py)
SEARCH_MIN_SIM=0.70
# Background embeddings per day, below the free tier's ~1,000 requests/day
EMBED_DAILY_BUDGET=900

# Search and embedding tuning (defaults are fine). hash = local stand-in for tests, none = meaning search off.
EMBEDDINGS_PROVIDER=
EMBEDDINGS_TIMEOUT=1.5
SEARCH_VEC_FLOOR=0.50

# --- Staff console sign-in (/admin). Empty ADMIN_PASSWORD falls back to DASHBOARD_TOKEN: set a real one. ---
ADMIN_USER=admin
ADMIN_PASSWORD=

# --- How long a verified patient is remembered, in minutes (phone + date of birth / website sign-in) ---
VERIFIED_SESSION_MIN=30
WEB_SESSION_MIN=120

# --- Email sender. auto = Gmail API if Google is connected, otherwise SMTP ---
EMAIL_VIA=auto
EMAIL_FROM_NAME=WellNest Hospitals
EMAIL_FROM_ADDRESS=

# --- Hospital Google account (Calendar events + Gmail send). Empty = .ics invites and SMTP ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary
GOOGLE_SEND_MAIL=true

# --- Payments: Razorpay Payment Links. Empty = a labelled demo payment page ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Medicines held out of stock for the demo (restock time keeps moving to tomorrow). Empty in real use. ---
DEMO_OUT_OF_STOCK=TELMA40

# --- Local only ---
PORT=8000
# SQLite file used when DATABASE_URL is empty
DB_PATH=

# --- Autonomous outbound calls (Talkdesk Flows API -> Studio "API request" flow). Empty = calls are simulated. ---
OUTBOUND_ENABLED=false
TALKDESK_ACCOUNT=your-account-name
TALKDESK_CLIENT_ID=
TALKDESK_CLIENT_SECRET=
TALKDESK_OUTBOUND_FLOW_ID=
# Every call rings this number instead of the patient's (demo safety). E.164, e.g. +12185550100
OUTBOUND_TEST_NUMBER=
# Patients the scheduler may call; "*" = everyone. Default: the 5 demo personas.
OUTBOUND_ALLOWLIST=
# Token the Studio flow's Execute Action sends in the X-Outbound-Token header (defaults to JOBS_TOKEN)
OUTBOUND_WEBHOOK_TOKEN=
OUTBOUND_CALL_HOURS=9-20
OUTBOUND_MAX_ATTEMPTS=3
OUTBOUND_RETRY_MIN=30
OUTBOUND_MAX_PER_RUN=2
